# ==============================================================================
# AI Document Intelligence & Workflow Platform — Environment Configuration
# Copy this file to '.env' and update variables as needed for your environment.
# ==============================================================================

# Application Environment (production / development / test)
APP_ENV=production

# Storage & Database Locations (Optional overrides, defaults to project root)
# DATABASE_PATH=data/documents.db
# STORAGE_DIR=storage

# Upload Security Limits
MAX_FILE_SIZE_MB=20

# AI/ML & Workflow Thresholds
CONFIDENCE_THRESHOLD=0.70
DEFAULT_CLASSIFICATION_MODEL=Logistic Regression

# RAG & AI Assistant Configuration
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.12
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30

# Anomaly Detection Settings
ANOMALY_ARITHMETIC_TOLERANCE=0.05
ANOMALY_MAX_INVOICE_AMOUNT=1000000.0
ANOMALY_MAX_FUTURE_DAYS=365

# Optional External AI API Keys (Leave blank to use built-in offline NLP engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
