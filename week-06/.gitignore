# Python virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Pytest & Cache
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Environment variables & secrets
.env
*.local

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs & SQLite WAL journals
*.log
*.db-shm
*.db-wal

# Storage runtime uploads (ignore new uploads, keep seed files tracked)
storage/invoices/*
!storage/invoices/.gitkeep
!storage/invoices/invoice_20260925*
storage/resumes/*
!storage/resumes/.gitkeep
!storage/resumes/resume_20260925*
storage/other/*
!storage/other/.gitkeep
!storage/other/other_20260925*

