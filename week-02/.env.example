# =============================================================================
# Zyroo AI Document Intelligence Platform — Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# =============================================================================

# Server Settings
APP_ENV=development
PORT=8501
HOST=0.0.0.0

# Optional Tesseract Binary Location (leave blank to auto-detect from PATH)
# Examples:
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Default Classification Engine: "Hybrid", "Rule-Based", or "ML"
DEFAULT_CLASSIFICATION_MODE=Hybrid
